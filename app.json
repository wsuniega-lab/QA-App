{
  "expo": {
    "name": "Precast QA",
    "slug": "precast-qa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.precastqa.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.precastqa.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Precast QA uses the camera to take pre-pour inspection photos.",
          "photosPermission": "Precast QA lets you attach existing photos to an inspection.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "precastqa"
  }
}
